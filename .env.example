# .env.example — kontrak environment OneCast
# Salin ke .env lalu isi dari dashboard Supabase (tidak di-commit).
# Lihat prisma.config.ts (DATABASE_URL) dan dokumentasi Supabase untuk detail pooling.

# Database (Supabase)
# App memakai Transaction Pooler (6543 + ?pgbouncer=true).
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true
# Migrasi Prisma memakai koneksi direct/session (5432).
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[SUPABASE-ANON-KEY]
SUPABASE_SERVICE_ROLE_KEY=[SUPABASE-SERVICE-ROLE-KEY]

# AI Providers — server-only, JANGAN pakai prefix NEXT_PUBLIC_.
# GOOGLE_AI_API_KEY: gratis di aistudio.google.com/apikey (tempel mentah).
GOOGLE_AI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="OneCast"
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=3600000
